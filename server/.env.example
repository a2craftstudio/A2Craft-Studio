# Copy to .env (never commit it). All values are read at start-up.

NODE_ENV=development
PORT=3100

# Database: PostgreSQL. REQUIRED in production (Supabase: Project > Connect > Transaction pooler, port 6543).
# Replace [YOUR-PASSWORD] with your database password. URL-encode special characters in it (@ -> %40, # -> %23, / -> %2F, : -> %3A).
# Leave empty in development to use the embedded PGlite database (stored in ./data/pglite, no server needed).
# `#` starts a comment in .env files: wrap the whole value in quotes if it contains one.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# TLS: require (default for remote hosts: encrypted AND certificate verified), no-verify (encrypted, not verified), disable (default for localhost).
# Supabase's certificate is signed by its own CA: either set DATABASE_SSL_CA to the downloaded CA file
# (Project Settings > Database > SSL Configuration) or use no-verify.
DATABASE_SSL=
DATABASE_SSL_CA=
# Maximum connections in the pool (default 10). Keep it well below your plan's pooler limit.
DATABASE_POOL_MAX=10

# REQUIRED in production, at least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random secret is generated at every start (sessions then reset on restart).
JWT_SECRET=

# Public origin of the site, no trailing slash. Used in emails and for the Origin check. REQUIRED in production.
SITE_ORIGIN=http://localhost:4200
# Extra origins allowed to send state-changing requests (comma separated). Normally empty.
ALLOWED_ORIGINS=

# Secure cookies. Defaults to true in production, false otherwise.
COOKIE_SECURE=
# Number of reverse proxies in front of Node (Nginx/Render/Fly = 1). 0 when exposed directly.
TRUST_PROXY=0

# Uploads: <dir>/public is served at /media, <dir>/private only through signed /files links.
UPLOAD_DIR=./storage
# Angular build to serve with SPA fallback. Default: ../dist/a2-craft-studio/browser when it exists.
CLIENT_DIST=

# Razorpay (https://dashboard.razorpay.com). Never put these in the Angular app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Fake payments for local development ONLY. Ignored when NODE_ENV=production.
PAYMENT_SIMULATOR=false

# Email through Resend. Without RESEND_API_KEY emails are logged as one line each.
RESEND_API_KEY=
MAIL_FROM=A2 Craft Studio <onboarding@resend.dev>
OWNER_EMAIL=

# First admin, created at start-up only when no admin exists yet. Or run: npm run create-admin -- <email> <password> [name]
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Studio Admin
